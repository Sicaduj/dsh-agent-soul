# macOS
.DS_Store

# Node.js
node_modules/
npm-debug.log*

# Environment and credentials (never commit)
.env
.env.*
!.env.example

# DSH plugin runtime state (plugin-owned; contains live session bindings).
# The default `bindingsFile` anchors state under the workspace's hidden `.dsh` dir.
.dsh/agent-soul/

# Resolved workspace soul catalog. In this workspace it is a runtime mirror of the
# packaged `agents/` catalog (installed souls are copied here on demand), so the
# tracked source of truth stays `agents/` and this copy never enters the diff.
.dsh/agents/

# Legacy state layout used by releases before the bundled-default layout
state/bindings.json
state/preferences.json
state/trash/

# Local verification evidence (screenshots, captured URLs, temporary servers)
smoke/evidence/

# Logs and editor noise
*.log
.idea/
.vscode/
