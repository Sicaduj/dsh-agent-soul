# macOS
.DS_Store

# Node.js
node_modules/
npm-debug.log*

# Environment and credentials (never commit)
.env
.env.*
!.env.example

# DSH plugin runtime state (plugin-owned; contains live session bindings).
# The default `bindingsFile` anchors state under the workspace's hidden `.dsh` dir.
.dsh/agent-soul/

# Legacy state layout used by releases before the bundled-default layout
state/bindings.json
state/preferences.json
state/trash/

# Logs and editor noise
*.log
.idea/
.vscode/
